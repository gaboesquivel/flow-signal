{
  "name": "flow-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node tooling/setup/setup.mjs",
    "skills:install": "pnpm dlx skills@1.7.4 experimental_install",
    "skills:update": "pnpm dlx skills@1.7.4 update -p -y",
    "setup:portless": "portless trust && portless proxy start",
    "dev": "portless",
    "dev:app": "next dev",
    "build": "pnpm run build:mcp-app && next build --webpack",
    "build:mcp-app": "vite build --config mcp-app/vite.config.ts",
    "build:agents": "for agent in agents/*/; do (cd \"$agent\" && eve build) || exit 1; done",
    "start": "pnpm build:agents && next start",
    "db:migrate": "drizzle-kit push --force",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write --no-error-on-unmatched-pattern .",
    "format": "oxfmt --write --no-error-on-unmatched-pattern .",
    "check-types": "tsc-ts --noEmit",
    "test": "pnpm run build:mcp-app && vitest run && node --test tooling/setup/data-preset.test.mjs tooling/setup/skills-lock.test.mjs",
    "qa": "pnpm lint && pnpm check-types && pnpm test",
    "eval": "pnpm eval:genui:offline && vitest run evals/eve-smoke.test.ts",
    "eval:offline": "node --import tsx lib/genui/scripts/eval-offline.ts",
    "eval:genui:offline": "pnpm eval:offline",
    "agentic:check": "sh -c 'if [ -z \"${AGENTIC_CHECK_URL:-}\" ]; then echo \"agentic:check requires AGENTIC_CHECK_URL (public host without scheme)\"; exit 1; fi; case \"$AGENTIC_CHECK_URL\" in http://*|https://*) echo \"agentic:check: omit https:// from AGENTIC_CHECK_URL\"; exit 1;; esac; exec is-agentic \"$AGENTIC_CHECK_URL\"'",
    "security:repo": "node tooling/security/check-repository.mjs",
    "security:check": "node --test tooling/security/block-secret-files.test.mjs && node tooling/security/check-repository.mjs && pnpm audit --prod --audit-level=high",
    "hooks:pre-commit": "node tooling/security/block-secret-files.mjs && node tooling/checks/check-staged.mjs",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/gateway": "4.0.125",
    "@base-ui/react": "^1.9.0",
    "@faker-js/faker": "10.5.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.90.5",
    "@typesafe-ai/sdk": "^0.7.0",
    "ai": "^7.0.152",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "eve": "^0.83.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.10.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "is-agentic": "^1.0.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "portless": "^0.15.10",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4.3.3",
    "tsc-ts": "^0.0.9",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "ultracite": "8.0.2",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "3.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run hooks:pre-commit"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "portless": {
    "name": "flow-next",
    "script": "dev:app"
  }
}
