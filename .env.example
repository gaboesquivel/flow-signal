# Vercel AI Gateway for /api/chat, /api/operator/chat, and GenUI tier-3 compose.
# On Vercel, OIDC authenticates the Gateway with no key; set a key for local development.
AI_GATEWAY_API_KEY=

# Optional chat / GenUI model ids (Gateway provider strings, e.g. anthropic/claude-sonnet-4.6)
# CHAT_MODEL=anthropic/claude-sonnet-5.5
# GENUI_MODEL=anthropic/claude-sonnet-4.6

# Signal decision model (decision briefs; spec 007, decision 0008). Default Claude Sonnet 5.5;
# set anthropic/claude-fable-5.1 to compare.
# SIGNAL_DECISION_MODEL=anthropic/claude-sonnet-5.5

# Optional Eve agent models (default anthropic/claude-sonnet-5.5)
# EVE_AGENT_MODEL=
# EVE_OPERATOR_MODEL=

# Operator (protected surfaces) — min 16 characters; unset disables Operator fail-closed
OPERATOR_SECRET=
# Deprecated alias (flow-next only): OPERATOR_ACCESS_TOKEN=


# Neon connection written by `pnpm neon:setup` (see docs/database.md). Signal endpoints return
# database_unavailable without it.
DATABASE_URL=

# Local test database: Postgres 18 + pgvector in Docker behind the local Neon proxy
# (`pnpm db:up`). The harness creates the database and applies the schema on demand. Give each
# parallel worktree its own database name (signal_test_<suffix>). Unset: tests run on in-process
# PGlite (as in CI).
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/signal_test
