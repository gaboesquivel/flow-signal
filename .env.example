# Vercel AI Gateway for /api/chat, /api/operator/chat, and GenUI tier-3 compose.
# On Vercel, OIDC authenticates the Gateway with no key; set a key for local development.
AI_GATEWAY_API_KEY=

# Optional chat / GenUI model ids (Gateway provider strings, e.g. anthropic/claude-sonnet-4.6)
# CHAT_MODEL=anthropic/claude-sonnet-5.5
# GENUI_MODEL=anthropic/claude-sonnet-4.6

# Signal decision model (decision briefs; spec 007, decision 0008). Default Claude Sonnet 5.5;
# set anthropic/claude-fable-5.1 to compare.
# SIGNAL_DECISION_MODEL=anthropic/claude-sonnet-5.5

# Optional Eve agent models (default anthropic/claude-sonnet-5.5)
# EVE_AGENT_MODEL=
# EVE_OPERATOR_MODEL=

# Operator (protected surfaces) — min 16 characters; unset disables Operator fail-closed
OPERATOR_SECRET=
# Deprecated alias (flow-next only): OPERATOR_ACCESS_TOKEN=

# >>> local defaults: `pnpm env:sync` (run by `pnpm db:dev`) adds each key below to .env.local
# when .env.local does not mention it; it never overwrites a value or an empty/commented-out key.
# Deployments do not read this file: there these stay off unless set in Vercel.
# Experimental Operator assistant in Console → Chat (spec 014): on | off (off when unset)
OPERATOR_ASSISTANT=on
# <<< local defaults

# Local development: Docker Postgres behind the local Neon proxy (`pnpm db:dev` creates, migrates,
# and seeds it; decision 0009). A Neon branch URL also works. Signal endpoints return
# database_unavailable without it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/signal_dev

# Local test database: Postgres 18 + pgvector in Docker behind the local Neon proxy
# (`pnpm db:up`). The harness creates the database and applies the schema on demand. In a linked
# git worktree the tests use `signal_test_<worktree dir>` instead of `signal_test`, so parallel
# worktrees never reset each other's database. Empty (`DATABASE_URL_TEST= pnpm test`): tests run on
# in-process PGlite (as in CI).
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/signal_test
